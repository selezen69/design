# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не должен попадать в git (он уже в .gitignore).

# Строка подключения к PostgreSQL: postgresql://пользователь:пароль@хост:порт/имя_базы
DATABASE_URL=postgresql://postgres:password@localhost:5432/design_portfolio

# Включить TLS-подключение к базе данных. Нужно для облачной базы (Timeweb Cloud
# и другие управляемые БД), для локального PostgreSQL на своём компьютере — не нужно.
PGSSL=false

# Почтовый ящик, с которого сервер отправляет уведомления о заявках (нужен
# пароль для внешних приложений, не обычный пароль от почты)
EMAIL_USER=
EMAIL_PASS=

# Куда присылать уведомления о заявках. Если не указано — придёт на EMAIL_USER
EMAIL_TO=

# SMTP-сервер и порт (по умолчанию — Mail.ru). Менять не нужно, если
# используется ящик на mail.ru/inbox.ru/bk.ru/list.ru
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465

# Порт, на котором запускается сервер (необязательно, по умолчанию 3000)
PORT=3000
